// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(CLIENT)
  avatar_url   String?
  bio          String?
  skills       String[]
  company_name String?
  is_verified  Boolean  @default(false)
  is_banned    Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  wallet             Wallet?
  jobs               Job[]      @relation("ClientJobs")
  proposals          Proposal[] @relation("FreelancerProposals")
  clientContracts    Contract[] @relation("ClientContracts")
  freelanceContracts Contract[] @relation("FreelanceContracts")
  sentMessages       Message[]  @relation("SentMessages")
  otps               OTP[]

  @@index([email], name: "email_index")
}

model Wallet {
  id         String   @id @default(uuid())
  user_id    String   @unique
  balance    Decimal  @default(5000.0) @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String          @id @default(uuid())
  wallet_id    String
  amount       Decimal         @db.Decimal(10, 2)
  type         TransactionType
  description  String?
  reference_id String?
  created_at   DateTime        @default(now())

  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id])
}

model Job {
  id              String    @id @default(uuid())
  title           String
  description     String
  budget          Decimal   @db.Decimal(10, 2)
  skills_required String[]
  client_id       String
  deadline        DateTime?
  status          JobStatus @default(OPEN)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  client    User       @relation("ClientJobs", fields: [client_id], references: [id], onDelete: Cascade)
  proposals Proposal[] @relation("ClientJobs")
  contract  Contract?

  @@index([status])
  @@index([client_id])
}

model Proposal {
  id            String         @id @default(uuid())
  cover_letter  String
  bid_amount    Decimal        @db.Decimal(10, 2)
  status        ProposalStatus @default(PENDING)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  job_id        String
  freelancer_id String

  freelancer User      @relation("FreelancerProposals", fields: [freelancer_id], references: [id])
  job        Job       @relation("ClientJobs", fields: [job_id], references: [id], onDelete: Cascade)
  contract   Contract?

  @@unique([job_id, freelancer_id])
  @@index([job_id])
  @@index([freelancer_id])
}

model Contract {
  id              String         @id @default(uuid())
  job_id          String         @unique
  proposal_id     String         @unique
  client_id       String
  freelancer_id   String
  amount          Decimal        @db.Decimal(10, 2)
  escrow_amount   Decimal        @db.Decimal(10, 2)
  status          ContractStatus @default(FUNDED)
  submission_note String?
  submitted_at    DateTime?
  completed_at    DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  job        Job       @relation(fields: [job_id], references: [id])
  proposal   Proposal  @relation(fields: [proposal_id], references: [id])
  client     User      @relation("ClientContracts", fields: [client_id], references: [id])
  freelancer User      @relation("FreelanceContracts", fields: [freelancer_id], references: [id])
  messages   Message[]

  @@index([client_id])
  @@index([freelancer_id])
  @@index([status])
}

model Message {
  id          String   @id @default(uuid())
  contract_id String
  sender_id   String
  content     String
  created_at  DateTime @default(now())

  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  sender   User     @relation("SentMessages", fields: [sender_id], references: [id])

  @@index([contract_id])
}

model OTP {
  id         String   @id @default(uuid())
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  user_id    String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  FUNDED
  WORK_SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  DISPUTED
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  ESCROW_LOCK
  PAYOUT
  REFUND
}

enum Role {
  ADMIN
  CLIENT
  FREELANCER
}
